{
  // The Chronic Health public site: support, privacy, data transfer, and the
  // AI guides. Pages are static assets; the Worker script only handles /api/*
  // (the feedback form). Deploy with `npx wrangler deploy` from this folder.
  //
  // Deliberately separate from jacksoncurtis.me (the career site): it shares the
  // Cloudflare account, never pages or links.
  //
  // The repo root holds frozen redirect stubs for the old GitHub Pages URLs
  // (jntrcs.github.io/ChronicHealth-site/), which shipped app versions, App Store
  // Connect and downloaded AI guides still point at. Never delete them.
  "name": "chronichealth-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // Only /api/* runs the Worker; every page stays a free static request.
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    // The home page feedback form. A Worker can only send to a *verified*
    // Email Routing destination, not to a routed alias like
    // chsitefeedback@jacksoncurtis.me (tried: the send fails). So it sends to
    // the Gmail the catch-all delivers that alias to, FROM chsitefeedback@ so
    // the mail is easy to filter.
    { "name": "EMAIL", "destination_address": "jcurtis210@gmail.com" }
  ],
  "vars": {
    "FEEDBACK_TO": "jcurtis210@gmail.com"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "chronichealth.jacksoncurtis.me", "custom_domain": true }
  ]
}
